# Alpaca credentials (paste into .env — never commit .env)
# Standard names (preferred) or PACA_* legacy names are both accepted.
ALPACA_API_KEY=paper_key
ALPACA_SECRET_KEY=paper_secret
# Optional: streaming token for the live websocket feed (iex stream).
# Omit it and the bot falls back to REST daily-bar polling.
ALPACA_STREAMING_TOKEN=

# paper (default) or live — live requires you to mean it.
DEFAULT_ORDER_MODE=paper

# Risk / sizing
MAX_ORDER_SIZE_USD=25.00
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.15
MAX_POSITION_QTY=1000

# Comma-separated symbols to trade. Leave unset for the legacy
# AAPL,MSFT,GOOGL default. For penny stocks pick your own universe.
WATCHLIST=PENY,PLUG,SNDL
